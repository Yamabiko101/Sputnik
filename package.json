{
  "name": "sputnik",
  "version": "1.1.0",
  "description": "Sputnik offline mission-control productivity app.",
  "author": "Yamabiko101",
  "main": "out/main/main.js",
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "dist": "electron-vite build && electron-builder",
    "dist:mac": "electron-vite build && electron-builder --mac dmg zip",
    "preview": "electron-vite preview",
    "rebuild": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3"
  },
  "build": {
    "appId": "com.yamabiko.sputnik",
    "productName": "Sputnik",
    "directories": {
      "output": "release"
    },
    "icon": "build/icon.icns",
    "artifactName": "Sputnik-${version}-${arch}.${ext}",
    "files": [
      "out/**",
      "package.json"
    ],
    "asarUnpack": [
      "**/*.node"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        "dmg",
        "zip"
      ]
    }
  },
  "dependencies": {
    "better-sqlite3": "^12.10.0",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@vitejs/plugin-react": "^5.1.1",
    "electron": "^40.10.2",
    "electron-builder": "^26.15.0",
    "electron-vite": "^5.0.0",
    "vite": "^7.3.3"
  }
}
